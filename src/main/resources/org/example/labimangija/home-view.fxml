<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.labimangija.HomeController" prefHeight="400" prefWidth="600">
    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
            <Label text="Pealeht" style="-fx-font-size:18; -fx-font-weight:bold;"/>
            <Label text="Tere tulemast pealehele! Kasuta Küljeriba, et rakenduses navigeerida" wrapText="true"/>
            <HBox spacing="8">
                <Label text="Kirjuta siia oma nimi:"/>
                <TextField promptText="Ees- ja perekonnanimi"/>
            </HBox>
            <HBox spacing="8">
                <Label text="Kirjuta siia oma matrikli number:"/>
                <TextField promptText="Matrikli number"/>
            </HBox>
        </VBox>
    </children>

</AnchorPane>
