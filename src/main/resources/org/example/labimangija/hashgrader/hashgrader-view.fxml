<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.labimangija.hashgrader.HashGraderController"
      spacing="10" style="-fx-padding: 16; -fx-background-color: #1e1e1e;">
    <children>
        <Label text="Paisktabelid" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <TextArea fx:id="terminalArea"
                  editable="false"
                  wrapText="true"
                  VBox.vgrow="ALWAYS"
                  style="-fx-control-inner-background: #1e1e1e; -fx-font-family: 'Consolas'; -fx-highlight-fill: #3a3d41; -fx-highlight-text-fill: white; -fx-text-fill: #d4d4d4;"/>
        <HBox spacing="10">
            <children>
                <TextField fx:id="inputField"
                           onAction="#handleSubmit"
                           promptText="Sisesta käsk"
                           HBox.hgrow="ALWAYS"
                           style="-fx-font-family: 'Consolas';"/>
                <Button text="Sisesta" onAction="#handleSubmit"/>
            </children>
        </HBox>
        <Label fx:id="statusLabel" wrapText="true" style="-fx-text-fill: #f1f1f1;"/>
    </children>
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>
</VBox>
